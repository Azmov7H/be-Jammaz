# --- Required ---
# MongoDB connection string (Atlas or local).
# Local transactions require a replica set:
#   mongod --replSet rs0 ... then `rs.initiate()`
MONGODB_URI=mongodb://127.0.0.1:27017/transfer-erp

# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional ---
# Access token lifetime (jose time string). Default: 15m (T-AUTH-02)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime in days. Default: 30 (T-AUTH-02)
REFRESH_TOKEN_TTL_DAYS=30

# Auto-create user accounts on first Google login. Default false:
# uninvited OAuth logins are rejected until a manager creates the account.
OAUTH_AUTO_PROVISION=false

# Server port. Default: 5000
PORT=5000

# development | production | test
# WARNING: when NODE_ENV !== 'production', CORS allows ALL origins.
NODE_ENV=development

# Google OAuth credentials (only needed for /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the frontend (used for OAuth redirect URI and as a CORS origin)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Sprint 04 ---
# Log retention days (TTL index on logs collection). Default: 90
LOG_TTL_DAYS=90

# Required ONLY for standalone (non-replica-set) dev MongoDB: acknowledges
# that multi-document operations run non-atomically. NEVER set in production.
ALLOW_NON_ATOMIC_DEV=

# --- Sprint 06 ---
# Comma-separated extra CORS origins for production
# (localhost + NEXT_PUBLIC_BASE_URL are always included).
ALLOWED_ORIGINS=
# Production only: allow origin-less requests (health probes/same-host tooling)
ALLOW_ORIGIN_LESS=

# --- Sprint 07: performance ---
# Dashboard TTL cache in seconds; 0 disables. Invalidation = expiry only.
DASHBOARD_CACHE_TTL=30

# --- Production-Like Local (Docker) ---
# For the Docker-based production-like environment, use .env.production-local
# which is pre-configured with container hostnames and auth credentials.
# Start with: docker compose -f docker-compose.production-local.yml up -d --build
